---
import { ui } from '../i18n/labels';
import T from './T.astro';
---

<aside>
	<section class="wrapper section with-background bg-variant">
		<header class="section-header stack gap-2 lg:gap-4">
			<h3><T label={ui.joinTitle} /></h3>
			<p><T label={ui.joinText} /></p>
		</header>
	</section>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 2px solid var(--gray-0);
		border-bottom: 2px solid var(--gray-0);
		padding: 5rem 1.5rem;
		background-color: var(--gray-50);
		box-shadow: var(--shadow-sm);
	}

	h3 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 22ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem 1.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h3 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
