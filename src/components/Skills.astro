---
import { getCollection } from 'astro:content';
import { displayAlliances } from '../constants/constants';
import { skills } from '../i18n/labels';
import T from './T.astro';

const alliances = (await getCollection('alliances')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
).filter((project) => displayAlliances.includes(project.data.id));
---

<section class="box skills">
	<div class="stack gap-2 lg:gap-4">
		<h2><T label={skills.kvkTitle} /></h2>
		<p><T label={skills.kvkText} /> (<a class="external-link" href="https://ks-atlas.com/kingdom/351" target="_blank" rel="noopener">→ Atlas Score</a>)</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<h2><T label={skills.activeTitle} /></h2>
		<p><T label={skills.activeText} vars={{ n: alliances.length }} /></p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<h2><T label={skills.peacefulTitle} /></h2>
		<p><T label={skills.peacefulText} /></p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<h2><T label={skills.unitedTitle} /></h2>
		<p><T label={skills.unitedText} /></p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<h2><T label={skills.sanctuariesTitle} /></h2>
		<p><T label={skills.sanctuariesText} /></p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<h2><T label={skills.helpTitle} /></h2>
		<p><T label={skills.helpText} /></p>
	</div>
</section>

<style>
	.box {
		border: 2px solid var(--gray-0);
		border-radius: 0;
		padding: 1.5rem;
		background-color: var(--gray-50);
		box-shadow: var(--shadow-sm);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 0;
		overflow: hidden;
	}

	.skills > div {
		padding: 1.25rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.skills > div:last-child {
		border-bottom: 0;
	}

	.skills h2 {
		font-size: var(--text-lg);
		color: var(--link-color);
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			padding: 0;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 0;
		}

		.skills > div {
			padding: 2rem;
			border-right: 1px solid var(--gray-800);
			border-bottom: 1px solid var(--gray-800);
		}

		.skills > div:nth-child(3n) {
			border-right: 0;
		}

		.skills > div:nth-last-child(-n + 3) {
			border-bottom: 0;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
