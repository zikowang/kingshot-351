---
import '../styles/global.css';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const {
	title = 'K 351',
	description = 'Kingshot Kingdom 351',
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400..700;1,400..700&display=swap"
	rel="stylesheet"
/>
<script is:inline>
	// Page transitions. Inline in head so `pagereveal` is caught before first paint.
	// - Kingdom <-> Alliances: slide sideways (class vt-slide-next / vt-slide-prev).
	// - Alliance card <-> alliance page: card image grows into page image.
	// - Anything else: default fade from global.css.
	(() => {
		const norm = (p) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p);
		const tabs = ['/', '/alliances'];
		const isDetail = (p) => /^\/alliances\/[^/]+$/.test(p);
		const nameImg = (img) => img && (img.style.viewTransitionName = 'alliance-img');
		const cardImg = (detail) =>
			[...document.querySelectorAll('a.card')].find((a) => norm(new URL(a.href).pathname) === detail)
				?.querySelector('img');
		const detailImg = () => document.querySelector('main img');

		// Old page: name the image that should morph before its snapshot is taken.
		addEventListener('pageswap', (e) => {
			if (!e.viewTransition || !e.activation) return;
			const from = norm(location.pathname);
			const to = norm(new URL(e.activation.entry.url).pathname);
			try { sessionStorage.setItem('vt-from', from); } catch {}
			if (isDetail(to)) nameImg(cardImg(to));
			else if (isDetail(from)) nameImg(detailImg());
		});

		// New page: pick the animation and name the matching image.
		addEventListener('pagereveal', (e) => {
			if (!e.viewTransition) return;
			let from;
			try { from = sessionStorage.getItem('vt-from'); } catch {}
			const to = norm(location.pathname);
			const a = tabs.indexOf(from);
			const b = tabs.indexOf(to);
			const root = document.documentElement;
			let cls;
			if (a !== -1 && b !== -1 && a !== b) cls = b > a ? 'vt-slide-next' : 'vt-slide-prev';
			else if (isDetail(to)) nameImg(detailImg());
			else if (from && isDetail(from)) nameImg(cardImg(from));
			if (cls) root.classList.add(cls);
			e.viewTransition.finished.finally(() => cls && root.classList.remove(cls));
		});
	})();

	// This code is inlined in the head to make dark mode instant & blocking.
	const getThemePreference = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};
	// Pick label language: saved choice, else browser language, else English.
	(() => {
		const langs = ['en', 'ko', 'zh', 'fr', 'de', 'tr'];
		let lang;
		try { lang = localStorage.getItem('ui-lang'); } catch {}
		if (!langs.includes(lang)) lang = (navigator.language || 'en').slice(0, 2).toLowerCase();
		document.documentElement.dataset.uiLang = langs.includes(lang) ? lang : 'en';
	})();

	const isDark = getThemePreference() === 'dark';
	document.documentElement.classList[isDark ? 'add' : 'remove']('theme-dark');

	if (typeof localStorage !== 'undefined') {
		// Watch the document element and persist user preference when it changes.
		const observer = new MutationObserver(() => {
			const isDark = document.documentElement.classList.contains('theme-dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	}
</script>
