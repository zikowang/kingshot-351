---
import type { CollectionEntry } from 'astro:content';
import { shortEvents } from '../i18n/labels';
import T from './T.astro';
import WinsBadge from './WinsBadge.astro';

interface Props {
	project: CollectionEntry<'alliances'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/alliances/${id}`}>
	<div class="title">
    <div>{data.title}</div>
    <WinsBadge wins={data.wins} />
  </div>

	<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
  <div class="alliance-short-info-container">
    {data.short ? data.short.map((elem, index) => (<div class="description-container">
      <span class="description">{shortEvents[elem.split(" ")[0]] ? <T label={shortEvents[elem.split(" ")[0]]} /> : elem.split(" ")[0]}</span>
      <span class="description description-data">{elem.split(" ").slice(1).join(" ")}</span>
    </div>)) : null}
  </div>
</a>

<style>
	.card {
    position: relative;
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 20rem;
		background: var(--gray-100);
		border: 3px solid var(--gray-0);
		border-radius: 0;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
	}

	.card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 7px 7px 0 var(--accent-regular);
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.75rem;
		padding: 0.5rem 0.75rem;
		background: var(--gray-50);
		color: var(--gray-0);
		border: 2px solid var(--gray-0);
		box-shadow: 3px 3px 0 var(--accent-regular);
	}


  .description-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    /* gap: 0.25rem; */
  }

  .description {
    font-size: 0.825rem;
  }

  .alliance-short-info-container {
    position: absolute;
    /* Small text: plain font reads better than pixel. */
    font-family: var(--font-body);
    display: flex;
    flex-direction: column;
		z-index: 1;
    bottom: 0.75rem;
    right: 0.75rem;
		padding: 0.65rem 0.75rem;
		background: var(--gray-50);
		color: var(--gray-0);
		border: 2px solid var(--gray-0);
		box-shadow: 3px 3px 0 var(--accent-regular);
    gap: 0.25rem;
    opacity: 0.96;
  }

	.card > img {
		grid-area: 1 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease-out;
	}

	.card:hover > img {
		transform: scale(1.035);
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
		}

		.title {
			border-radius: 0;
		}
	}
</style>
